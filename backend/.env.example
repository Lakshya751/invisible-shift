# Invisible Shift — backend configuration
# Copy to backend/.env. Everything is optional: with no key the app runs in Demo Mode
# (synthetic sample plan, rule-based PDF extraction, deterministic Care Navigator).

# --- AI provider (choose one; OpenAI is used if both are set) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Force a mode: openai | gemini | none  (leave blank for auto-detect)
AI_PROVIDER=

# --- Storage & CORS ---
# DATABASE_URL=sqlite:///./invisible_shift.db
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
